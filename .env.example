# Todo Acesso - configuración de ejemplo. Copiá a .env y completá. NUNCA versiones .env.

APP_ENV=production            # production | local
APP_DEBUG=0                   # 1 solo en desarrollo
APP_URL=https://todoacesso.com
APP_KEY=                      # cadena aleatoria de 64+ caracteres (php bin/make-key.php)
APP_FORCE_HTTPS=0             # 1 = redirige http -> https (activar cuando el certificado esté instalado)
APP_AUTO_MIGRATE=0           # 1 = migra el esquema en cada arranque (útil en local)

# Base de datos: sqlite (por defecto) o mysql
DB_DRIVER=sqlite
DB_PATH=storage/database.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=todoacesso
DB_USER=
DB_PASS=

# Panel administrativo (hash con: php bin/make-admin-hash.php)
ADMIN_USER=
ADMIN_PASSWORD_HASH=

# Google Tag Manager (dejar vacío para desactivar). Formato GTM-XXXXXXX
GTM_ID=

# Contacto público (páginas legales)
CONTACT_EMAIL=contacto@todoacesso.com

# Verificación de disponibilidad
CHECK_CACHE_SECONDS=300       # no volver a consultar un dominio antes de este tiempo
CHECK_TIMEOUT_SECONDS=6       # timeout por intento
CHECK_MAX_REDIRECTS=4
CHECK_USER_AGENT=             # vacío = TodoAcessoBot/1.0 (+URL). Algunos WAF (p. ej. Santander) descartan UAs con "bot"/URL
CHECK_SLOW_MS=3000           # por encima de esto se marca "responde lento"
METADATA_REFRESH_DAYS=30

# Reportes
REPORT_COOLDOWN_SECONDS=120   # espera mínima entre reportes del mismo origen para un servicio
REPORT_PERIOD_SECONDS=3600    # ventana en la que no se repite el mismo tipo de reporte
REPORT_RETENTION_DAYS=90
LOCATION_DECIMALS=1           # decimales con que se guardan las coordenadas (1 ~ 11 km)
ACTIVITY_MIN_REPORTS=5        # mínimo de reportes en 2 h para marcar actividad elevada
ACTIVITY_FACTOR=2             # múltiplo sobre la actividad habitual

# Rate limiting (peticiones por ventana, por origen anónimo)
RL_SEARCH_PER_10MIN=40
RL_NEW_SERVICE_PER_HOUR=8
RL_RECHECK_PER_10MIN=30
RL_REPORT_PER_HOUR=20

# Proxy inverso de confianza (p. ej. Cloudflare). Lista de IPs separadas por coma.
TRUSTED_PROXIES=
